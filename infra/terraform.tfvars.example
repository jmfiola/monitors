# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored because
# every value below is a credential.
#
# Image tags are NOT here — they live in apps.auto.tfvars, which is committed, so
# that git records what is deployed.
#
# project_id, region and zone have defaults in variables.tf (cobs-cloud,
# us-west1, us-west1-b). Override only if you mean to.

# --- melanzana-monitor (Cowlendar appointment slots) ---
melanzana_discord_webhook_url = "https://discord.com/api/webhooks/xxxx/yyyy"
# melanzana_status_webhook_url = "https://discord.com/api/webhooks/xxxx/zzzz"
# melanzana_window_days        = 60
# melanzana_mention_everyone   = false   # true = @everyone-ping on every slot alert
# melanzana_heartbeat_at       = "07:00" # America/Denver; "" = drift with process start

# --- jeffco-sub-monitor (Jeffco substitute jobs) ---
# The access id and the PIN closely resemble each other, so treat them as one
# secret: leaking the id leaks most of the PIN.
jeffco_sfe_user_id         = "900001"
jeffco_sfe_pin             = "xxxxxx"
jeffco_discord_webhook_url = "https://discord.com/api/webhooks/xxxx/yyyy"
# jeffco_status_webhook_url = "https://discord.com/api/webhooks/xxxx/zzzz"
# jeffco_poll_interval_sec  = 45   # lower collides with the account holder's own session

# --- fashionjobs-monitor (France-wide Stage listings) ---
fashionjobs_discord_webhook_url = "https://discord.com/api/webhooks/xxxx/yyyy"
# fashionjobs_status_webhook_url = "https://discord.com/api/webhooks/xxxx/zzzz"
# fashionjobs_poll_interval_sec  = 600
# fashionjobs_heartbeat_at       = "07:00" # America/Denver; "" = drift with process start

# --- shared ops config ---
# heartbeat_interval_sec = 86400  # daily; raise to quiet it
# stall_alert_sec        = 600
